# Copy this file to `.env` and fill in your keys.

# ── OpenRouter (Stage 1 + Stage 2, proxied through server.js) ──
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
STAGE1_MODEL=deepseek/deepseek-v4-flash
STAGE2_MODEL=openai/gpt-5-nano

# ── KIE (Stage 3 image generation, proxied through server.js) ──
# Get a key at https://kie.ai
KIE_API_KEY=
KIE_IMAGE_MODEL=gpt-image-2-image-to-image
# 1K | 2K | 4K  (4K is not allowed with a 1:1 aspect ratio)
KIE_IMAGE_RESOLUTION=1K

# ── Supabase (database, used server-side to populate/read records) ──
# Project URL + keys from your project's API settings:
# https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
# Public anon key — safe for the browser (respects Row Level Security).
SUPABASE_ANON_KEY=
# Service role key — SECRET, server-only. Bypasses RLS, use for populating data.
SUPABASE_SERVICE_ROLE_KEY=
