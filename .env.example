# Shared password gate
APP_PASSWORD=
SESSION_SECRET=

# OpenRouter (stage 1 + stage 2)
OPENROUTER_API_KEY=
STAGE1_MODEL=deepseek/deepseek-v4-flash
STAGE2_MODEL=openai/gpt-5-nano

# KIE (stage 3 image generation)
KIE_API_KEY=
