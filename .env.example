# Copy this file to `.env` and fill in your keys.

# ── OpenRouter (Stage 1 + Stage 2, proxied through server.js) ──
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
STAGE1_MODEL=deepseek/deepseek-v4-flash
STAGE2_MODEL=openai/gpt-5-nano

# ── KIE (Stage 3 image generation, proxied through server.js) ──
# Get a key at https://kie.ai
KIE_API_KEY=
KIE_IMAGE_MODEL=gpt-image-2-image-to-image
# 1K | 2K | 4K  (4K is not allowed with a 1:1 aspect ratio)
KIE_IMAGE_RESOLUTION=1K
