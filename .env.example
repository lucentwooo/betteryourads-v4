# Copy this file to `.env` (repo root) and fill in your keys.
# The TypeScript backend (apps/backend) reads these at startup.

# ── OpenRouter (Stage 1 brand DNA + Stage 2 ad prompt) ──
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
STAGE1_MODEL=deepseek/deepseek-v4-flash
# Stage 2 needs a vision-capable model.
STAGE2_MODEL=google/gemini-2.5-flash
STAGE3_MODEL=deepseek/deepseek-v4-flash

# ── KIE (Stage 3 image generation) ──
# Get a key at https://kie.ai
KIE_API_KEY=
KIE_IMAGE_MODEL=gpt-image-2-image-to-image
# 1K | 2K | 4K  (4K is not allowed with a 1:1 aspect ratio)
KIE_IMAGE_RESOLUTION=1K

# ── Daily creative quota (optional — defaults shown) ──
# Per-user daily render cap; resets at local midnight in GENERATION_TZ. Admin is uncapped.
DAILY_GENERATION_LIMIT=10
GENERATION_TZ=Australia/Sydney

# ── Supabase (database + storage, used server-side to populate/read records) ──
# Project URL + keys from your project's API settings:
# https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
# Public anon key — safe for the browser (respects Row Level Security).
SUPABASE_ANON_KEY=
# Service role key — SECRET, server-only. Bypasses RLS, use for populating data.
SUPABASE_SERVICE_ROLE_KEY=
