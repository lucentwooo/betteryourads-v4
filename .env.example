# Copy this file to `.env` and fill in your keys.

# ── OpenRouter (Stage 1 + Stage 2, proxied through server.js) ──
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
STAGE1_MODEL=deepseek/deepseek-v4-flash
STAGE2_MODEL=google/gemini-2.5-flash
# Models the admin Stage 1 / Stage 2 pickers may choose from (comma-separated OpenRouter IDs).
# A client-supplied model is only honored if it appears here; STAGE1_MODEL / STAGE2_MODEL are
# always selectable even if omitted. Stage 2 needs a vision-capable model.
OPENROUTER_CHAT_MODELS=deepseek/deepseek-v4-flash,google/gemini-2.5-flash,openai/gpt-5-nano,google/gemini-3-pro-image-preview,anthropic/claude-sonnet-4.6

# ── Stage 3 image backend: "openrouter" or "kie" (default: kie) ──
# openrouter = one synchronous call through OpenRouter (no upload host, no polling).
# kie        = KIE GPT-Image-2 (async upload + task + poll).
IMAGE_BACKEND=openrouter
# Only used when IMAGE_BACKEND=openrouter. Any OpenRouter image-output model works
# (e.g. openai/gpt-5.4-image-2, google/gemini-3-pro-image-preview, google/gemini-2.5-flash-image).
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
# Models the /admin model picker may choose from (comma-separated OpenRouter IDs).
# A client-supplied model is only honored if it appears in this list.
OPENROUTER_IMAGE_MODELS=openai/gpt-5.4-image-2,google/gemini-3-pro-image-preview,google/gemini-3.1-flash-image-preview

# ── KIE (Stage 3 image generation, proxied through server.js) ──
# Get a key at https://kie.ai
KIE_API_KEY=
KIE_IMAGE_MODEL=gpt-image-2-image-to-image
# 1K | 2K | 4K  (4K is not allowed with a 1:1 aspect ratio)
KIE_IMAGE_RESOLUTION=1K

# ── Supabase (database, used server-side to populate/read records) ──
# Project URL + keys from your project's API settings:
# https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
# Public anon key — safe for the browser (respects Row Level Security).
SUPABASE_ANON_KEY=
# Service role key — SECRET, server-only. Bypasses RLS, use for populating data.
SUPABASE_SERVICE_ROLE_KEY=

# ── Lifetime free generation cap (non-admin users) ──
# Admins (profiles.is_admin = true, set only via SQL) are unlimited. Every other
# account may run this many successful generations TOTAL (all-time), then must be
# made admin to continue. Used by /usage and /kie/generate.
LIFETIME_GENERATION_LIMIT=5
# Legacy daily-cap vars (no longer enforced; kept so usage.js helpers + tests load):
DAILY_GENERATION_LIMIT=10
GENERATION_TZ=Australia/Sydney
